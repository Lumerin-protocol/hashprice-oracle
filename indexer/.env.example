# Subgraph Configuration
# Copy this file to .env and update values for local development
# Current values are for Arbitrum Sepolia testnet in DEV
# For CI/CD and ECS deployments, these are set as environment variables

# Network name (localhost, arbitrum-sepolia, arbitrum)
NETWORK=arbitrum-sepolia

# Hashrate Oracle contract address
HASHPRICE_USD_ADDRESS=0x0000000000000000000000000000000000000000
HASHPRICE_BTC_ADDRESS=0x0000000000000000000000000000000000000000

# BTC Token Oracle contract address (Chainlink BTC/USD price feed)
BTC_USD_ADDRESS=0x0000000000000000000000000000000000000000

# Block number to start indexing data feeds
HASHPRICE_START_BLOCK=0


# Ethereum RPC URL (runtime)
SUBGRAPH_ETH_NODE=http://localhost:8545
