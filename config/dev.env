# Public, per-environment values for DEV (base-sepolia).
#
# Loaded by Hardhat (`--env dev`), the keeper (`--env-file`), the subgraph
# renderer (`ENV_FILE`), and the deploy workflows, which build the Lambda
# environment from the keys in this file.
#
# Never put secrets here. Those live in the repo-root `.env` locally and in
# GitHub Secrets in CI, and both take precedence over this file.
#
# Values are unquoted on purpose: `docker run --env-file` does not strip quotes
# in every CLI version, unlike Node, bash, and Compose.

NETWORK=base-sepolia
CHAIN_ID=84532

# ── Contracts ──────────────────────────────────────────────────────────────
BTC_USD_ADDRESS=0x37b5e07c59238ad3bb11ac27129387a67f3340b6
HASHPRICE_BTC_ADDRESS=0x7b7f9698cadca34f13d6091c4ee34045f97442e7
HASHPRICE_USD_ADDRESS=0x7df07e84e57890f429935946748757758f7964f1
USDC_TOKEN_ADDRESS=0xdd15eed84065a58c9e9ff9e95fb996be0fff22aa
CHAINLINK_BTC_USD_ADDRESS=0x64c911996D3c6aC71f9b455B1E8E7266BcbD848F

# ── Subgraph manifests ─────────────────────────────────────────────────────
HASHPRICE_START_BLOCK=40253846
SUBGRAPH_ETH_NODE=hardhat:https://localhost:8545

# ── Keeper runtime ─────────────────────────────────────────────────────────
LOG_LEVEL=debug
UPDATE_BTC_USD=true
KEEPER_POLL_INTERVAL_MS=300000

# ── Seed scripts ───────────────────────────────────────────────────────────
BTC_SEED_START=940000
ETH_SEED_START_BLOCK=43157678
