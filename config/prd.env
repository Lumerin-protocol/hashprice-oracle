# Public, per-environment values for PRD (base mainnet).
#
# Loaded by Hardhat (`--env prd`), the keeper (`--env-file`), the subgraph
# renderer (`ENV_FILE`), and the deploy workflows, which build the Lambda
# environment from the keys in this file.
#
# Never put secrets here. Those live in the repo-root `.env` locally and in
# GitHub Secrets in CI, and both take precedence over this file.
#
# Values are unquoted on purpose: `docker run --env-file` does not strip quotes
# in every CLI version, unlike Node, bash, and Compose.
#
# `base-mainnet` is this repo's Hardhat network name and the value already
# deployed in this file. The Graph manifest name is `base`; prepare:env maps
# that at the subgraph boundary and leaves this spelling for everything else.

NETWORK=base-mainnet
CHAIN_ID=8453

# ── Contracts ──────────────────────────────────────────────────────────────
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
HASHPRICE_BTC_ADDRESS=0x70027c6f1b40e7461172af1241330b499c8c2e22
BTC_USD_ADDRESS=0x64c911996D3c6aC71f9b455B1E8E7266BcbD848F
HASHPRICE_USD_ADDRESS=0xf30a6489f20630bf5b1a76f0c56aadc364d031f3

# ── Subgraph manifests ─────────────────────────────────────────────────────
HASHPRICE_START_BLOCK=51348538

# ── Keeper runtime ─────────────────────────────────────────────────────────
KEEPER_MAX_BATCH_SIZE=20
LOG_LEVEL=debug
